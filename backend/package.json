{
  "name": "sicis_backend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "init-db": "node -e \"import('./db-init.js').then(m => m.initializeDatabase())\"",
